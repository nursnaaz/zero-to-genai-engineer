{
  "manifest_version": 3,
  "name": "Jev Ad Swipe File",
  "version": "1.0.0",
  "description": "Saves competitor ads from the Meta Ad Library and tags each one with Jev.",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "content_scripts": [{
    "matches": ["https://www.facebook.com/ads/library/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup.html" },
  "options_page": "options.html"
}
